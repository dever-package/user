{
  "page": {
    "name": "身份权益编辑",
    "parent": "user/identity_benefit/list",
    "type": 2,
    "auth": [
      {
        "key": "user/identity_benefit/update",
        "name": "身份权益编辑"
      }
    ]
  },
  "layout": {
    "type": "container",
    "children": {
      "page-main": {
        "type": "main",
        "className": "p-0",
        "children": {
          "dialog-shell": {
            "type": "container",
            "className": "w-full",
            "children": {
              "periodic-benefit-page": {
                "type": "container",
                "path": "/user/identity_benefit/periodic_list",
                "className": "mt-5"
              },
              "billing-benefit-page": {
                "type": "container",
                "path": "/user/identity_benefit/billing_list",
                "className": "mt-5"
              }
            }
          }
        }
      }
    }
  },
  "nodes": {
    "dialog-shell": [
      {
        "type": "show-base",
        "name": "身份",
        "value": "form.identity.name",
        "mode": "form",
        "meta": {
          "formLayout": "horizontal"
        }
      },
      {
        "type": "show-base",
        "name": "等级",
        "value": "form.name",
        "mode": "form",
        "meta": {
          "formLayout": "horizontal"
        }
      },
      {
        "type": "form-array",
        "name": "权益描述",
        "value": "form.benefit_descriptions",
        "mode": "form",
        "info": "用于订阅卡片展示。配置后将覆盖周期发放和计费系数等技术说明；未配置时继续使用系统自动说明。",
        "meta": {
          "pageRoute": "/user/identity_benefit/description",
          "addText": "添加权益描述",
          "itemName": "权益描述",
          "emptyText": "暂无自定义权益描述，前台将展示系统自动说明。",
          "drag": "sort",
          "formLayout": "horizontal"
        }
      }
    ]
  },
  "data": {
    "form": {
      "id": "",
      "identity_id": "",
      "name": "",
      "level": 0,
      "benefit_descriptions": [],
      "periodic_benefits": [],
      "billing_benefits": [],
      "_fields": [
        "identity_id",
        "name",
        "level",
        "benefit_descriptions",
        "periodic_benefits",
        "billing_benefits"
      ],
      "service": "user.BenefitService.AttachIdentityBenefitForm",
      "model": "user.NewIdentityLevelModel"
    }
  },
  "state": {},
  "action": {
    "submit": {
      "type": "save",
      "upsert": true,
      "params": "form",
      "data": {
        "id": "$form.id",
        "identity_id": "$form.identity_id",
        "identity_name": "$form.identity.name",
        "level_id": "$form.id",
        "level_name": "$form.name",
        "level": "$form.level",
        "_virtual": true,
        "benefit_descriptions": "$form.benefit_descriptions",
        "periodic_benefits": "$form.periodic_benefits",
        "billing_benefits": "$form.billing_benefits"
      },
      "before": {
        "service": "user.BenefitService.BeforeSaveIdentityBenefit"
      },
      "model": "user.NewIdentityLevelModel"
    }
  }
}
