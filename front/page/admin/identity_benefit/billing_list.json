{
  "page": {
    "name": "计费权益",
    "parent": "user/identity_benefit/list",
    "type": 2,
    "sort": 13
  },
  "layout": {
    "type": "container",
    "className": "rounded-md border bg-background",
    "children": {
      "page-header": {
        "type": "header",
        "className": "gap-4 border-b px-4 py-3",
        "children": {
          "header-actions": {
            "type": "row",
            "className": "ms-auto shrink-0 flex-nowrap items-center gap-2"
          }
        }
      },
      "table-row": {
        "type": "container",
        "className": "overflow-hidden"
      }
    }
  },
  "nodes": {
    "page-header": [
      {
        "type": "show-title",
        "value": "page",
        "className": "min-w-0 flex-1"
      }
    ],
    "header-actions": [
      {
        "type": "show-button",
        "name": "添加计费权益",
        "meta": {
          "variant": "outline",
          "size": "sm"
        },
        "action": {
          "click": [
            {
              "type": "state",
              "key": "billingBenefitIndex",
              "value": -1
            },
            {
              "type": "state",
              "key": "billingBenefitForm",
              "value": {
                "point_config_id": 1,
                "scope": "all",
                "power_cate_id": 0,
                "power_ids": [],
                "sale_ratio": "1",
                "status": 1,
                "sort": 100
              }
            },
            {
              "type": "modal",
              "key": "dialog.billingBenefit",
              "value": true
            }
          ]
        }
      }
    ],
    "table-row": [
      {
        "type": "show-table",
        "value": "parent.data.form.billing_benefits",
        "meta": {
          "rowKey": "id",
          "columns": [
            {
              "name": "扣费积分",
              "value": "point_config_id",
              "type": "show-tag",
              "className": "text-center",
              "meta": {
                "option": "option.point_config"
              }
            },
            {
              "name": "范围",
              "value": "scope",
              "type": "show-tag",
              "className": "text-center",
              "meta": {
                "option": "option.scope"
              }
            },
            {
              "name": "售价系数",
              "value": "sale_ratio",
              "type": "show-base",
              "className": "text-center"
            },
            {
              "name": "启用",
              "value": "status",
              "type": "form-switch",
              "action": {
                "change": {
                  "type": "array",
                  "key": "parent.data.form.billing_benefits",
                  "op": "patch",
                  "index": "$rowIndex",
                  "value": {
                    "status": "$value"
                  }
                }
              },
              "meta": {
                "trueValue": 1,
                "falseValue": 2
              }
            },
            {
              "name": "排序",
              "value": "sort",
              "type": "show-base",
              "editor": "form-number",
              "trigger": "doubleClick",
              "action": {
                "change": {
                  "type": "array",
                  "key": "parent.data.form.billing_benefits",
                  "op": "patch",
                  "index": "$rowIndex",
                  "value": {
                    "sort": "$value"
                  }
                }
              },
              "meta": {
                "controlClassName": "w-24"
              }
            },
            {
              "name": "操作",
              "type": "show-button",
              "className": "w-[1%] whitespace-nowrap px-3 text-center",
              "meta": {
                "buttons": [
                  {
                    "icon": "square-pen",
                    "variant": "outline",
                    "size": "sm",
                    "description": "编辑计费权益",
                    "action": {
                      "click": [
                        {
                          "type": "state",
                          "key": "billingBenefitIndex",
                          "value": "$rowIndex"
                        },
                        {
                          "type": "state",
                          "key": "billingBenefitForm",
                          "value": "$row"
                        },
                        {
                          "type": "modal",
                          "key": "dialog.billingBenefit",
                          "value": true
                        }
                      ]
                    }
                  },
                  {
                    "icon": "trash-2",
                    "variant": "outline",
                    "size": "sm",
                    "description": "删除计费权益",
                    "className": "text-destructive hover:text-destructive",
                    "action": {
                      "click": [
                        {
                          "type": "state",
                          "key": "deleteBillingBenefitIndex",
                          "value": "$rowIndex"
                        },
                        {
                          "type": "modal",
                          "key": "dialog.deleteBillingBenefit",
                          "value": true
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "type": "feedback-modal",
        "meta": {
          "stateKey": "dialog.billingBenefit",
          "pageRoute": "/user/identity_benefit/billing",
          "title": "计费权益",
          "description": "按供应商成本和售价系数计算用户应扣积分。",
          "size": "lg",
          "footer": {
            "confirm": true,
            "confirmText": "确定"
          },
          "pageDataPatches": {
            "form": "state.billingBenefitForm"
          }
        },
        "action": {
          "submit": {
            "type": "array",
            "key": "parent.data.form.billing_benefits",
            "op": "upsert",
            "index": "state.billingBenefitIndex",
            "value": "$modalForm"
          }
        }
      },
      {
        "type": "feedback-confirm",
        "name": "删除计费权益",
        "info": "确认删除这一条计费权益吗？删除后当前行内容将被移除。",
        "meta": {
          "stateKey": "dialog.deleteBillingBenefit",
          "successMessage": "计费权益已删除"
        },
        "action": {
          "confirm": {
            "type": "array",
            "key": "parent.data.form.billing_benefits",
            "op": "remove",
            "index": "state.deleteBillingBenefitIndex"
          }
        }
      }
    ]
  },
  "data": {
    "page": {
      "title": "计费权益",
      "description": "配置能力调用使用的积分和售价系数。"
    },
    "option": {
      "point_config": {
        "service": "user.UserOptionService.LoadPointConfigs"
      },
      "scope": [
        {
          "id": "all",
          "value": "全部能力"
        },
        {
          "id": "specified",
          "value": "指定能力"
        }
      ]
    }
  },
  "state": {
    "billingBenefitIndex": -1,
    "deleteBillingBenefitIndex": -1,
    "billingBenefitForm": {
      "point_config_id": 1,
      "scope": "all",
      "power_cate_id": 0,
      "power_ids": [],
      "sale_ratio": "1",
      "status": 1,
      "sort": 100
    },
    "dialog": {
      "billingBenefit": false,
      "deleteBillingBenefit": false
    }
  },
  "action": {}
}
